modules = ["python-base-3.13", "nodejs-24"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 5002
externalPort = 3001

[[ports]]
localPort = 8001
externalPort = 80

[nix]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Aerodynamix Standalone"

[[workflows.workflow]]
name = "Aerodynamix Standalone"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd Aerodynamix20/Aerodynamix20/attached_assets && python3 -m http.server 5000 --bind 0.0.0.0"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
